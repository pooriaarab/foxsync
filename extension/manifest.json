{
  "manifest_version": 3,
  "name": "foxsync — approve agent steps from your phone",
  "version": "0.1.2",
  "description": "Control your Firefox agent from your phone over an encrypted peer-to-peer link.",
  "icons": { "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png" },
  "browser_specific_settings": {
    "gecko": {
      "id": "foxsync@pooriaarab",
      "strict_min_version": "153.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "action": {
    "default_icon": { "48": "icons/icon-48.png", "96": "icons/icon-96.png" },
    "default_title": "foxsync",
    "default_popup": "popup.html"
  },
  "sidebar_action": {
    "default_icon": { "48": "icons/icon-48.png", "96": "icons/icon-96.png" },
    "default_title": "foxsync",
    "default_panel": "popup.html",
    "open_at_install": false
  }
}
