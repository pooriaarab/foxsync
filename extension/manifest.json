{
  "manifest_version": 3,
  "name": "foxsync demo",
  "version": "0.1.1",
  "description": "Control your Firefox agent from your phone over an encrypted peer-to-peer link.",
  "browser_specific_settings": {
    "gecko": {
      "id": "foxsync@pooriaarab",
      "strict_min_version": "153.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "action": {
    "default_title": "foxsync demo",
    "default_popup": "popup.html"
  },
  "sidebar_action": {
    "default_title": "foxsync",
    "default_panel": "popup.html",
    "open_at_install": false
  }
}
