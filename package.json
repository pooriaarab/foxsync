{
  "name": "foxsync",
  "version": "0.1.0",
  "description": "Control your Firefox agent from your phone over an encrypted peer-to-peer link.",
  "type": "module",
  "license": "MIT",
  "author": "Pooria Arab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pooriaarab/foxsync.git"
  },
  "homepage": "https://github.com/pooriaarab/foxsync#readme",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run --passWithNoTests",
    "ci:local": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm build:ext && pnpm lint:ext && pnpm build:phone",
    "build:ext": "node scripts/build-ext.mjs",
    "lint:ext": "web-ext lint -s dist-ext --warnings-as-errors",
    "e2e": "pnpm build:ext && pnpm build:phone && node e2e/run.mjs",
    "build:phone": "node scripts/build-phone.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "create-foxkit": "^0.1.0",
    "esbuild": "^0.28.2",
    "oxlint": "^1.87.0",
    "typescript": "^7.0.2",
    "uqr": "0.1.3",
    "vitest": "^5.0.3",
    "web-ext": "^10.7.0"
  }
}
